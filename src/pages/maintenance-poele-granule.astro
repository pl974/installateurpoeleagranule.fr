---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Maintenance & Entretien' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de fois par an faut-il ramoner un poêle à granulés ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le ramonage d'un poêle à granulés est obligatoire 2 fois par an, dont au moins 1 fois pendant la période de chauffe. Cette obligation est fixée par le Règlement Sanitaire Départemental Type (RSDT). En cas de non-respect, vous risquez une amende de 450€ et un refus d'indemnisation par votre assurance en cas de sinistre."
      }
    },
    {
      "@type": "Question",
      "name": "Quel est le coût d'entretien annuel d'un poêle à granulés ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le coût d'entretien annuel d'un poêle à granulés varie entre 200€ et 400€, incluant : 2 ramonages obligatoires (120-200€), 1 entretien annuel complet par un professionnel (150-250€), et les consommables (produit nettoyant vitre, joints : 20-50€/an)."
      }
    },
    {
      "@type": "Question",
      "name": "Puis-je entretenir mon poêle à granulés moi-même ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, vous pouvez et devez effectuer l'entretien courant (nettoyage quotidien/hebdomadaire du creuset, vitre, cendrier). En revanche, le ramonage et l'entretien annuel approfondi doivent obligatoirement être réalisés par un professionnel qualifié qui vous délivre un certificat de ramonage indispensable pour votre assurance."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle est la durée de vie d'un poêle à granulés bien entretenu ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un poêle à granulés bien entretenu a une durée de vie moyenne de 15 à 20 ans. Les modèles haut de gamme (Rika, MCZ) peuvent dépasser 20 ans avec un entretien rigoureux. Les pièces d'usure (vis d'alimentation, joints, ventilateurs, bougie d'allumage) doivent être remplacées tous les 5-7 ans."
      }
    },
    {
      "@type": "Question",
      "name": "Quels sont les signes qu'un poêle à granulés a besoin d'un entretien ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Signes d'un entretien nécessaire : vitre qui noircit rapidement, flamme jaune/orange au lieu de blanche/bleue, augmentation de la consommation de granulés, présence de fumée dans la pièce, bruits anormaux, difficultés d'allumage, messages d'erreur répétés, production excessive de cendres."
      }
    }
  ]
};
---

<BaseLayout
  title="Entretien Poêle à Granulé : Guide Complet Maintenance 2024"
  description="Entretien poêle à granulés : ramonage obligatoire 2×/an, nettoyage quotidien/hebdomadaire, coût 200-400€/an. Guide complet + planning maintenance."
  keywords={['entretien poêle à granulé', 'ramonage poêle pellet', 'nettoyage poêle granulé', 'maintenance poêle à granulés', 'coût entretien annuel']}
>
  <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={breadcrumbItems} />

        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-6">
            Entretien et Maintenance d'un Poêle à Granulé
          </h1>
          <p class="text-xl text-gray-600">
            Guide complet pour prolonger la durée de vie de votre poêle et garantir son fonctionnement optimal
          </p>
        </div>

        <!-- Alerte ramonage obligatoire -->
        <div class="bg-red-50 border-l-4 border-red-600 p-6 mb-12 rounded-r-lg">
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-red-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <div>
              <h2 class="font-bold text-red-900 text-lg mb-2">⚠️ Ramonage obligatoire 2 fois par an</h2>
              <p class="text-red-800">
                Le ramonage d'un poêle à granulés est <strong>obligatoire 2 fois par an</strong>, dont au moins 1 fois pendant la période de chauffe.
                Cette obligation est fixée par le Règlement Sanitaire Départemental Type (RSDT).
              </p>
              <p class="text-red-800 mt-2">
                <strong>Amende en cas de non-respect :</strong> jusqu'à 450€ + refus d'indemnisation par votre assurance en cas de sinistre (incendie, intoxication CO).
              </p>
            </div>
          </div>
        </div>

        <article class="prose prose-lg max-w-none">
          <!-- Entretien quotidien -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6">🔥 Entretien quotidien (1-2 minutes)</h2>

          <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">À faire tous les jours en période de chauffe</h3>
            <ul class="space-y-3">
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <div>
                  <strong class="text-gray-900">Vérifier le niveau de granulés</strong>
                  <p class="text-sm text-gray-700">S'assurer qu'il reste suffisamment de granulés dans la trémie. Un manque de granulés peut provoquer un arrêt du poêle et une procédure de rallumage fastidieuse.</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <div>
                  <strong class="text-gray-900">Observer la flamme</strong>
                  <p class="text-sm text-gray-700">Une flamme saine doit être <strong>vive, claire, blanche à bleutée</strong>. Une flamme jaune/orange indique une combustion incomplète (manque d'air, granulés humides, creuset encrassé).</p>
                </div>
              </li>
            </ul>
            <p class="text-xs text-gray-600 mt-4 italic">⏱️ Temps nécessaire : 1-2 minutes par jour</p>
          </div>

          <!-- Entretien hebdomadaire -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">🧹 Entretien hebdomadaire (10-15 minutes)</h2>

          <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">À faire 1 fois par semaine (poêle froid éteint)</h3>
            <ul class="space-y-4">
              <li class="flex items-start space-x-3">
                <div class="flex-shrink-0 w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm">1</div>
                <div>
                  <strong class="text-gray-900">Nettoyer le creuset de combustion</strong>
                  <p class="text-sm text-gray-700 mb-2">Gratter les résidus de combustion avec la raclette fournie. Un creuset encrassé réduit l'arrivée d'air et provoque une mauvaise combustion (fumée noire, surconsommation).</p>
                  <p class="text-xs text-gray-600"><strong>Astuce :</strong> Pour faciliter le nettoyage, effectuez-le juste après l'extinction, quand les cendres sont encore tièdes (attention aux brûlures).</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <div class="flex-shrink-0 w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm">2</div>
                <div>
                  <strong class="text-gray-900">Nettoyer la vitre</strong>
                  <p class="text-sm text-gray-700 mb-2">Utiliser un produit spécifique pour vitre de poêle ou du papier journal humide avec des cendres froides. Éviter les produits ménagers classiques qui laissent des traces.</p>
                  <p class="text-xs text-gray-600"><strong>Pourquoi la vitre noircit ?</strong> Granulés de mauvaise qualité, manque d'air comburant, température trop basse, ou creuset encrassé.</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <div class="flex-shrink-0 w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm">3</div>
                <div>
                  <strong class="text-gray-900">Vider le cendrier</strong>
                  <p class="text-sm text-gray-700 mb-2">Retirer et vider le cendrier (capacité moyenne 2-5 litres selon modèles). Un cendrier plein empêche l'évacuation des cendres et peut obstruer le creuset.</p>
                  <p class="text-xs text-gray-600"><strong>⚠️ Attention :</strong> Laisser refroidir complètement les cendres avant de les jeter (risque d'incendie). Utiliser un contenant métallique fermé.</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <div class="flex-shrink-0 w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center font-bold text-sm">4</div>
                <div>
                  <strong class="text-gray-900">Inspecter visuellement</strong>
                  <p class="text-sm text-gray-700">Vérifier l'absence de fissures sur le verre, l'état des joints de porte, l'absence de fuites d'air autour des raccordements. Signaler toute anomalie à votre installateur.</p>
                </div>
              </li>
            </ul>
            <p class="text-xs text-gray-600 mt-4 italic">⏱️ Temps nécessaire : 10-15 minutes par semaine</p>
          </div>

          <!-- Entretien mensuel -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">🔧 Entretien mensuel (30 minutes)</h2>

          <div class="bg-orange-50 border border-orange-200 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">À faire 1 fois par mois</h3>
            <ul class="space-y-3">
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-orange-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                </svg>
                <div>
                  <strong class="text-gray-900">Aspirer les conduits internes</strong>
                  <p class="text-sm text-gray-700">Utiliser un aspirateur à cendres pour nettoyer les conduits de fumée internes, les passages d'air, et le fond de la chambre de combustion.</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-orange-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                </svg>
                <div>
                  <strong class="text-gray-900">Nettoyer l'échangeur thermique</strong>
                  <p class="text-sm text-gray-700">Brosser ou aspirer l'échangeur (tubes à l'arrière du poêle) pour éviter l'accumulation de suie qui réduit le rendement de 10-15%.</p>
                </div>
              </li>
              <li class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-orange-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                </svg>
                <div>
                  <strong class="text-gray-900">Vérifier la trémie et la vis d'alimentation</strong>
                  <p class="text-sm text-gray-700">Inspecter la trémie (présence de sciure, poussière), nettoyer si nécessaire. Vérifier que la vis tourne librement sans bruit anormal.</p>
                </div>
              </li>
            </ul>
            <p class="text-xs text-gray-600 mt-4 italic">⏱️ Temps nécessaire : 30 minutes par mois</p>
          </div>

          <!-- Entretien annuel professionnel -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">👨‍🔧 Entretien annuel professionnel (obligatoire)</h2>

          <div class="bg-purple-50 border border-purple-200 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Intervention par un professionnel qualifié 1 fois/an</h3>

            <p class="text-gray-700 mb-4">
              L'entretien annuel complet doit être réalisé par un <strong>professionnel qualifié</strong> de préférence avant chaque saison de chauffe (septembre-octobre). Cette maintenance approfondie garantit la sécurité, le rendement optimal et la longévité de votre appareil.
            </p>

            <h4 class="font-bold text-gray-900 mb-3">🔍 Ce qui est inclus dans l'entretien annuel :</h4>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Démontage et nettoyage complet</strong> : creuset, brûleur, extracteur fumées, ventilateurs, échangeur thermique</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Vérification électronique</strong> : carte électronique, sondes de température, sécurités (pressostat, thermostat de sécurité)</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Contrôle de la combustion</strong> : réglage débit d'air, contrôle des émissions de CO, optimisation rendement</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Vérification mécanique</strong> : moteur réducteur, vis sans fin, roulements, joints d'étanchéité</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Test de fonctionnement</strong> : allumage, montée en température, extinction, ventilations</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-purple-600">✓</span>
                <span class="text-sm text-gray-700"><strong>Compte-rendu écrit</strong> : état général, anomalies détectées, recommandations, date prochain entretien</span>
              </li>
            </ul>

            <div class="bg-white rounded-lg p-4">
              <p class="font-bold text-gray-900 mb-2">💰 Tarif entretien annuel :</p>
              <p class="text-2xl font-bold text-purple-600">150€ - 250€ TTC</p>
              <p class="text-sm text-gray-600 mt-1">Selon modèle et région. Pièces détachées non incluses.</p>
            </div>
          </div>

          <!-- Ramonage obligatoire -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">🚨 Ramonage : Obligation légale 2×/an</h2>

          <div class="bg-red-50 border-2 border-red-300 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-bold text-red-900 mb-4">Pourquoi le ramonage est-il obligatoire ?</h3>

            <p class="text-gray-700 mb-4">
              Le ramonage du conduit d'évacuation des fumées est une <strong>obligation légale</strong> fixée par le Règlement Sanitaire Départemental Type (RSDT).
              Pour un poêle à granulés, vous devez faire ramoner le conduit <strong>2 fois par an minimum</strong>, dont au moins <strong>1 fois pendant la période de chauffe</strong>.
            </p>

            <h4 class="font-bold text-gray-900 mb-3">📋 Que comprend un ramonage professionnel ?</h4>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start space-x-2">
                <span class="text-red-600">•</span>
                <span class="text-sm text-gray-700">Nettoyage mécanique du conduit sur toute sa longueur (hérisson + brosse)</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-red-600">•</span>
                <span class="text-sm text-gray-700">Élimination des dépôts de suie, bistre et goudrons</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-red-600">•</span>
                <span class="text-sm text-gray-700">Vérification de l'état du conduit (fissures, déformations)</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-red-600">•</span>
                <span class="text-sm text-gray-700">Contrôle du tirage et de la vacuité du conduit</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-red-600">•</span>
                <span class="text-sm text-gray-700"><strong>Délivrance d'un certificat de ramonage</strong> (obligatoire pour l'assurance)</span>
              </li>
            </ul>

            <div class="bg-white rounded-lg p-4 mb-4">
              <p class="font-bold text-gray-900 mb-2">💰 Tarif ramonage :</p>
              <p class="text-xl font-bold text-red-600">60€ - 100€ TTC par intervention</p>
              <p class="text-sm text-gray-600 mt-1">Soit 120€ - 200€/an pour les 2 ramonages obligatoires.</p>
            </div>

            <div class="bg-yellow-50 border-l-4 border-yellow-600 p-4">
              <p class="font-bold text-yellow-900 mb-2">⚠️ Sanctions en cas de non-ramonage :</p>
              <ul class="space-y-1 text-sm text-yellow-800">
                <li>• Amende forfaitaire : jusqu'à <strong>450€</strong></li>
                <li>• Refus d'indemnisation assurance en cas d'incendie ou intoxication CO</li>
                <li>• Responsabilité pénale en cas d'accident grave</li>
                <li>• Non-conformité pour la revente du bien immobilier</li>
              </ul>
            </div>
          </div>

          <!-- Coût total annuel -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">💰 Coût total d'entretien annuel</h2>

          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-8 mb-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Budget entretien annuel complet</h3>

            <div class="space-y-4">
              <div class="flex items-center justify-between py-3 border-b border-blue-200">
                <span class="text-gray-700 font-medium">Ramonage × 2 (obligatoire)</span>
                <span class="text-lg font-bold text-gray-900">120€ - 200€</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-blue-200">
                <span class="text-gray-700 font-medium">Entretien annuel professionnel</span>
                <span class="text-lg font-bold text-gray-900">150€ - 250€</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-blue-200">
                <span class="text-gray-700 font-medium">Consommables (nettoyant vitre, joints)</span>
                <span class="text-lg font-bold text-gray-900">20€ - 50€</span>
              </div>
              <div class="flex items-center justify-between py-4 bg-primary-100 rounded-lg px-4 mt-4">
                <span class="text-xl font-bold text-primary-900">TOTAL annuel</span>
                <span class="text-3xl font-bold text-primary-600">290€ - 500€</span>
              </div>
            </div>

            <p class="text-sm text-gray-600 mt-6 text-center italic">
              Soit environ <strong>24€ - 42€ par mois</strong> pour un fonctionnement optimal et sécurisé.
            </p>
          </div>

          <!-- Contrats d'entretien -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">📝 Contrats d'entretien : Avantages</h2>

          <p class="text-gray-700 mb-6">
            De nombreux installateurs RGE proposent des <strong>contrats d'entretien annuels</strong> qui regroupent l'entretien professionnel et les 2 ramonages obligatoires.
            Ces contrats offrent plusieurs avantages par rapport à des interventions ponctuelles.
          </p>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-green-50 border border-green-200 rounded-lg p-6">
              <h3 class="font-bold text-green-900 mb-4 flex items-center space-x-2">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Avantages du contrat</span>
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start space-x-2">
                  <span class="text-green-600">✓</span>
                  <span>Tarif préférentiel (économie 10-20%)</span>
                </li>
                <li class="flex items-start space-x-2">
                  <span class="text-green-600">✓</span>
                  <span>Rendez-vous automatiques programmés</span>
                </li>
                <li class="flex items-start space-x-2">
                  <span class="text-green-600">✓</span>
                  <span>Priorité d'intervention en cas de panne</span>
                </li>
                <li class="flex items-start space-x-2">
                  <span class="text-green-600">✓</span>
                  <span>Remise sur les pièces détachées (10-15%)</span>
                </li>
                <li class="flex items-start space-x-2">
                  <span class="text-green-600">✓</span>
                  <span>Historique d'entretien centralisé</span>
                </li>
              </ul>
            </div>

            <div class="bg-white border-2 border-primary-300 rounded-lg p-6">
              <h3 class="font-bold text-primary-900 mb-4">💳 Tarif contrat annuel</h3>
