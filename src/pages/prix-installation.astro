---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Prix & Installation' }
];
---

<BaseLayout
  title="Prix Installation Poêle à Granulé 2024 - Tarifs & Devis Détaillé"
  description="Prix détaillé installation poêle à granulé : coût de l'appareil (2000€-9000€), main d'œuvre, tubage. Aides financières jusqu'à 3500€. Devis gratuit en 24h."
  keywords={['prix poêle à granulé', 'coût installation poêle granulé', 'tarif pose poêle pellets', 'devis poêle à granulé', 'prix installation RGE']}
>
  <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={breadcrumbItems} />

        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-6">
            Prix d'Installation d'un Poêle à Granulé 2024
          </h1>
          <p class="text-xl text-gray-600">
            Tous les tarifs détaillés : achat de l'appareil, installation, tubage et aides financières pour estimer votre budget réel. Pour tout savoir sur le choix et l'installation, consultez notre <a href="/guide" class="text-primary-600 hover:text-primary-800 font-semibold underline">guide complet</a>.
          </p>
        </div>

        <!-- Prix moyen -->
        <div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-2xl p-8 mb-12 text-center">
          <h2 class="text-2xl font-bold mb-4">💰 Prix moyen installation complète</h2>
          <p class="text-5xl font-bold mb-2">4 000€ - 10 000€</p>
          <p class="text-primary-100 mb-6">Appareil + installation + tubage</p>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 inline-block">
            <p class="text-sm font-semibold mb-2">Avec les aides financières :</p>
            <p class="text-3xl font-bold">2 500€ - 6 000€</p>
            <p class="text-sm text-primary-100">Reste à charge après MaPrimeRénov' + CEE</p>
          </div>
        </div>

        <!-- Prix de l'appareil -->
        <article class="prose prose-lg max-w-none">
          <h2 class="text-3xl font-bold text-gray-900 mb-6">
            1. Prix d'achat du poêle à granulé
          </h2>

          <p class="text-gray-700 mb-6">
            Le prix d'un poêle à granulé varie considérablement selon la <strong>puissance, la marque, les fonctionnalités et le design</strong>. Voici un guide détaillé des prix par gamme :
          </p>

          <div class="overflow-x-auto mb-8">
            <table class="min-w-full bg-white border-2 border-gray-200 rounded-lg">
              <thead class="bg-gradient-to-r from-gray-100 to-gray-200">
                <tr>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Gamme</th>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Prix poêle seul</th>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Caractéristiques</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 font-bold text-gray-900">Entrée de gamme</td>
                  <td class="px-6 py-4 text-lg font-bold text-primary-600">2 000€ - 3 500€</td>
                  <td class="px-6 py-4">
                    <ul class="text-sm space-y-1">
                      <li>• Rendement correct (87-89%)</li>
                      <li>• Fonctions basiques</li>
                      <li>• Design simple</li>
                      <li>• Puissance 6-10 kW</li>
                    </ul>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 font-bold text-gray-900">Milieu de gamme</td>
                  <td class="px-6 py-4 text-lg font-bold text-primary-600">3 500€ - 5 500€</td>
                  <td class="px-6 py-4">
                    <ul class="text-sm space-y-1">
                      <li>• Rendement élevé (90-92%)</li>
                      <li>• Programmation avancée</li>
                      <li>• Design soigné</li>
                      <li>• Nettoyage semi-automatique</li>
                      <li>• Télécommande incluse</li>
                    </ul>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 font-bold text-gray-900">Haut de gamme</td>
                  <td class="px-6 py-4 text-lg font-bold text-primary-600">5 500€ - 9 000€</td>
                  <td class="px-6 py-4">
                    <ul class="text-sm space-y-1">
                      <li>• Rendement optimal (93-96%)</li>
                      <li>• Connexion Wi-Fi</li>
                      <li>• Très silencieux (30-35 dB)</li>
                      <li>• Design premium</li>
                      <li>• Nettoyage automatique</li>
                      <li>• Marques : Rika, MCZ, Palazzetti</li>
                    </ul>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">Prix par marque</h3>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">Rika 🇦🇹</h4>
                <span class="text-yellow-500">⭐ 4.9/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">4 000€ - 9 000€</p>
              <p class="text-sm text-gray-600">Haut de gamme autrichien, rendement exceptionnel >95%, qualité premium</p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">MCZ 🇮🇹</h4>
                <span class="text-yellow-500">⭐ 4.8/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">3 200€ - 7 500€</p>
              <p class="text-sm text-gray-600">Innovation italienne, technologie No Air, design primé, très silencieux</p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">Palazzetti 🇮🇹</h4>
                <span class="text-yellow-500">⭐ 4.8/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">3 500€ - 8 000€</p>
              <p class="text-sm text-gray-600">Design haut de gamme, nettoyage automatique, Wi-Fi inclus</p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">Extraflame 🇮🇹</h4>
                <span class="text-yellow-500">⭐ 4.7/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">2 800€ - 6 500€</p>
              <p class="text-sm text-gray-600">Leader européen, large gamme, excellent rapport qualité-prix</p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">Edilkamin 🇮🇹</h4>
                <span class="text-yellow-500">⭐ 4.6/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">2 500€ - 5 500€</p>
              <p class="text-sm text-gray-600">Marque italienne fiable, bon rapport qualité-prix, large choix</p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6 hover:border-primary-500 transition-colors">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-xl font-bold text-gray-900">Invicta 🇫🇷</h4>
                <span class="text-yellow-500">⭐ 4.5/5</span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mb-2">2 200€ - 4 800€</p>
              <p class="text-sm text-gray-600">Fabrication française, robuste, prix attractifs, SAV de proximité</p>
            </div>
          </div>

          <!-- Prix installation -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">
            2. Coût de la main d'œuvre et de l'installation
          </h2>

          <p class="text-gray-700 mb-6">
            L'installation d'un poêle à granulé doit obligatoirement être réalisée par un <strong>professionnel certifié RGE Qualibois</strong> pour garantir la sécurité, la conformité aux normes et l'accès aux aides financières. Découvrez notre <a href="/marques" class="text-primary-600 hover:text-primary-800 font-semibold underline">comparatif complet des marques</a> pour choisir le modèle adapté à votre budget.
          </p>

          <div class="bg-primary-50 border-l-4 border-primary-600 p-6 mb-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Tarifs main d'œuvre RGE</h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between py-2 border-b border-primary-200">
                <span class="text-gray-700 font-medium">Installation standard (1 jour)</span>
                <span class="text-xl font-bold text-primary-600">1 000€ - 1 500€</span>
              </div>
              <div class="flex items-center justify-between py-2 border-b border-primary-200">
                <span class="text-gray-700 font-medium">Installation complexe (2 jours)</span>
                <span class="text-xl font-bold text-primary-600">1 500€ - 2 500€</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="text-gray-700 font-medium">Installation avec travaux importants</span>
                <span class="text-xl font-bold text-primary-600">2 500€ - 4 000€</span>
              </div>
            </div>
            <p class="text-sm text-gray-600 mt-4">
              ℹ️ La main d'œuvre comprend : déplacement, pose, raccordements, tests, mise en service, formation
            </p>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">Travaux complémentaires</h3>

          <div class="overflow-x-auto mb-8">
            <table class="min-w-full bg-white border-2 border-gray-200 rounded-lg">
              <thead class="bg-gray-100">
                <tr>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Prestation</th>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Prix</th>
                  <th class="px-6 py-4 text-left font-bold text-gray-900">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr>
                  <td class="px-6 py-4 font-medium">Tubage conduit vertical</td>
                  <td class="px-6 py-4 font-bold text-primary-600">500€ - 1 500€</td>
                  <td class="px-6 py-4 text-sm">Insertion d'un tube inox dans conduit existant</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Installation ventouse</td>
                  <td class="px-6 py-4 font-bold text-primary-600">800€ - 1 200€</td>
                  <td class="px-6 py-4 text-sm">Sortie horizontale en façade (sans conduit)</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Création conduit extérieur</td>
                  <td class="px-6 py-4 font-bold text-primary-600">1 500€ - 3 000€</td>
                  <td class="px-6 py-4 text-sm">Conduit inox isolé en façade</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Prise d'air extérieure</td>
                  <td class="px-6 py-4 font-bold text-primary-600">200€ - 400€</td>
                  <td class="px-6 py-4 text-sm">Obligatoire pour poêle étanche</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Socle / Plaque de sol</td>
                  <td class="px-6 py-4 font-bold text-primary-600">150€ - 400€</td>
                  <td class="px-6 py-4 text-sm">Protection du sol (acier, verre, pierre)</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Protection murale</td>
                  <td class="px-6 py-4 font-bold text-primary-600">200€ - 500€</td>
                  <td class="px-6 py-4 text-sm">Écran thermique ou habillage</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium">Gaines pour canalisation</td>
                  <td class="px-6 py-4 font-bold text-primary-600">500€ - 1 500€</td>
                  <td class="px-6 py-4 text-sm">Distribution chaleur dans plusieurs pièces</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Exemples de prix -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">
            3. Exemples de prix complets (installation clé en main)
          </h2>

          <div class="space-y-6 mb-12">
            <!-- Exemple 1 -->
            <div class="bg-gradient-to-br from-green-50 to-green-100 border-2 border-green-300 rounded-xl p-8">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900">Configuration Économique</h3>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full font-bold text-lg">4 500€</span>
              </div>
              <div class="space-y-3 mb-6">
                <div class="flex items-center justify-between py-2 border-b border-green-200">
                  <span class="text-gray-700">Poêle entrée de gamme 8 kW (Invicta, Edilkamin)</span>
                  <span class="font-bold text-gray-900">2 500€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-green-200">
                  <span class="text-gray-700">Installation RGE (avec tubage existant)</span>
                  <span class="font-bold text-gray-900">1 200€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-green-200">
                  <span class="text-gray-700">Tubage conduit (6 mètres)</span>
                  <span class="font-bold text-gray-900">600€</span>
                </div>
                <div class="flex items-center justify-between py-2">
                  <span class="text-gray-700">Plaque de sol + accessoires</span>
                  <span class="font-bold text-gray-900">200€</span>
                </div>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold text-gray-900 mb-2">💚 Avec les aides :</p>
                <p class="text-sm text-gray-700 mb-1">• MaPrimeRénov' : - 1 500€</p>
                <p class="text-sm text-gray-700 mb-3">• Prime CEE : - 500€</p>
                <p class="text-xl font-bold text-green-700">Reste à charge : 2 500€</p>
              </div>
            </div>

            <!-- Exemple 2 -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 border-2 border-blue-300 rounded-xl p-8">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900">Configuration Standard</h3>
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full font-bold text-lg">6 800€</span>
              </div>
              <div class="space-y-3 mb-6">
                <div class="flex items-center justify-between py-2 border-b border-blue-200">
                  <span class="text-gray-700">Poêle milieu de gamme 10 kW (Extraflame, MCZ)</span>
                  <span class="font-bold text-gray-900">4 200€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-blue-200">
                  <span class="text-gray-700">Installation RGE (1 jour)</span>
                  <span class="font-bold text-gray-900">1 400€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-blue-200">
                  <span class="text-gray-700">Tubage conduit (8 mètres)</span>
                  <span class="font-bold text-gray-900">800€</span>
                </div>
                <div class="flex items-center justify-between py-2">
                  <span class="text-gray-700">Protection sol + mur + accessoires</span>
                  <span class="font-bold text-gray-900">400€</span>
                </div>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold text-gray-900 mb-2">💙 Avec les aides :</p>
                <p class="text-sm text-gray-700 mb-1">• MaPrimeRénov' : - 2 000€</p>
                <p class="text-sm text-gray-700 mb-1">• Prime CEE : - 800€</p>
                <p class="text-sm text-gray-700 mb-3">• TVA 5,5% : - 500€</p>
                <p class="text-xl font-bold text-blue-700">Reste à charge : 3 500€</p>
              </div>
            </div>

            <!-- Exemple 3 -->
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 border-2 border-purple-300 rounded-xl p-8">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold text-gray-900">Configuration Premium</h3>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full font-bold text-lg">10 500€</span>
              </div>
              <div class="space-y-3 mb-6">
                <div class="flex items-center justify-between py-2 border-b border-purple-200">
                  <span class="text-gray-700">Poêle haut de gamme 12 kW canalisable (Rika, Palazzetti)</span>
                  <span class="font-bold text-gray-900">7 000€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-purple-200">
                  <span class="text-gray-700">Installation RGE complexe (2 jours)</span>
                  <span class="font-bold text-gray-900">2 000€</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-purple-200">
                  <span class="text-gray-700">Gaines de canalisation (2 pièces)</span>
                  <span class="font-bold text-gray-900">1 000€</span>
                </div>
                <div class="flex items-center justify-between py-2">
                  <span class="text-gray-700">Protection + accessoires premium</span>
                  <span class="font-bold text-gray-900">500€</span>
                </div>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold text-gray-900 mb-2">💜 Avec les aides :</p>
                <p class="text-sm text-gray-700 mb-1">• MaPrimeRénov' : - 2 500€</p>
                <p class="text-sm text-gray-700 mb-1">• Prime CEE : - 1 000€</p>
                <p class="text-sm text-gray-700 mb-3">• TVA 5,5% : - 800€</p>
                <p class="text-xl font-bold text-purple-700">Reste à charge : 6 200€</p>
              </div>
            </div>
          </div>

          <!-- Facteurs qui influencent le prix -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">
            4. Facteurs qui influencent le prix d'installation
          </h2>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">🔥</span>
                La puissance du poêle
              </h4>
              <p class="text-sm text-gray-700">
                Plus la puissance est élevée (exprimée en kW), plus le prix augmente. Un poêle de 6 kW coûte moins cher qu'un 12 kW à gamme équivalente.
              </p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">🏷️</span>
                La marque et la gamme
              </h4>
              <p class="text-sm text-gray-700">
                Les marques premium (Rika, MCZ, Palazzetti) sont plus chères mais offrent meilleures performances, design soigné et durabilité supérieure.
              </p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">🎨</span>
                Le design et les finitions
              </h4>
              <p class="text-sm text-gray-700">
                Habillage céramique, pierre ollaire, finitions personnalisées augmentent le prix de 300€ à 1 500€.
              </p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">⚙️</span>
                Les fonctionnalités
              </h4>
              <p class="text-sm text-gray-700">
                Wi-Fi, nettoyage automatique, convection naturelle, poêle canalisable : chaque option ajoute 200€ à 1 500€.
              </p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">🏠</span>
                La configuration du logement
              </h4>
              <p class="text-sm text-gray-700">
                Absence de conduit, hauteur de tubage importante, difficultés d'accès augmentent les coûts d'installation.
              </p>
            </div>

            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
              <h4 class="font-bold text-gray-900 mb-3 flex items-center">
                <span class="text-2xl mr-3">📍</span>
                La localisation géographique
              </h4>
              <p class="text-sm text-gray-700">
                Les tarifs peuvent varier de 10-15% selon les régions. Zones urbaines généralement plus chères que zones rurales.
              </p>
            </div>
          </div>

          <!-- Coût d'utilisation annuel -->
          <h2 class="text-3xl font-bold text-gray-900 mb-6 mt-12">
            5. Coût d'utilisation annuel
          </h2>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">Consommation de granulés</h3>

          <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-xl p-6 mb-8">
            <div class="grid md:grid-cols-3 gap-6">
              <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-sm text-gray-600 mb-2">Maison 70 m²<br/>bien isolée</p>
                <p class="text-3xl font-bold text-primary-600 mb-1">1,5-2 T</p>
                <p class="text-sm font-semibold text-gray-700">450€ - 800€/an</p>
              </div>
              <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-sm text-gray-600 mb-2">Maison 100 m²<br/>isolation moyenne</p>
                <p class="text-3xl font-bold text-primary-600 mb-1">3-4 T</p>
                <p class="text-sm font-semibold text-gray-700">900€ - 1 600€/an</p>
              </div>
              <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-sm text-gray-600 mb-2">Maison 150 m²<br/>bien isolée</p>
                <p class="text-3xl font-bold text-primary-600 mb-1">3-4,5 T</p>
                <p class="text-sm font-semibold text-gray-700">900€ - 1 800€/an</p>
              </div>
            </div>
