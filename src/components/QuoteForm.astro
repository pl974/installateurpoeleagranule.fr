---
interface Props {
  cityName?: string;
}

const { cityName } = Astro.props;
---

<section id="devis" class="py-16 bg-gradient-to-br from-primary-50 to-accent-50">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-4">
          Obtenez votre devis gratuit {cityName ? `à ${cityName}` : 'en 2 minutes'}
        </h2>
        <p class="text-lg text-gray-600">
          Remplissez le formulaire et recevez jusqu'à 3 devis d'installateurs RGE certifiés
        </p>
        <div class="flex justify-center items-center space-x-6 mt-6">
          <div class="flex items-center space-x-2 text-green-700">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-semibold">100% Gratuit</span>
          </div>
          <div class="flex items-center space-x-2 text-green-700">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-semibold">Sans engagement</span>
          </div>
          <div class="flex items-center space-x-2 text-green-700">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-semibold">Réponse en 24h</span>
          </div>
        </div>
      </div>

      <form
        id="quote-form"
        name="devis"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="bg-white rounded-2xl shadow-soft-lg p-8"
      >
        <!-- Honeypot anti-spam (caché) -->
        <p class="hidden">
          <label>
            Ne pas remplir si vous êtes humain : <input name="bot-field" />
          </label>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Projet -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Type de projet *
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <label class="relative flex items-center justify-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-primary-500 transition-colors peer-checked:border-primary-500 peer-checked:bg-primary-50">
                <input type="radio" name="project_type" value="achat_installation" class="peer sr-only" required />
                <div class="text-center">
                  <svg class="w-8 h-8 mx-auto mb-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Achat + Installation</span>
                </div>
                <div class="absolute inset-0 rounded-lg peer-checked:ring-2 peer-checked:ring-primary-500 pointer-events-none"></div>
              </label>
              <label class="relative flex items-center justify-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-primary-500 transition-colors peer-checked:border-primary-500 peer-checked:bg-primary-50">
                <input type="radio" name="project_type" value="installation_seule" class="peer sr-only" />
                <div class="text-center">
                  <svg class="w-8 h-8 mx-auto mb-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Installation seule</span>
                </div>
                <div class="absolute inset-0 rounded-lg peer-checked:ring-2 peer-checked:ring-primary-500 pointer-events-none"></div>
              </label>
              <label class="relative flex items-center justify-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-primary-500 transition-colors peer-checked:border-primary-500 peer-checked:bg-primary-50">
                <input type="radio" name="project_type" value="renseignement" class="peer sr-only" />
                <div class="text-center">
                  <svg class="w-8 h-8 mx-auto mb-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm font-medium text-gray-900">Renseignement</span>
                </div>
                <div class="absolute inset-0 rounded-lg peer-checked:ring-2 peer-checked:ring-primary-500 pointer-events-none"></div>
              </label>
            </div>
          </div>

          <!-- Code postal -->
          <div>
            <label for="postal_code" class="block text-sm font-semibold text-gray-700 mb-2">
              Code postal *
            </label>
            <input
              type="text"
              id="postal_code"
              name="postal_code"
              pattern="[0-9]{5}"
              placeholder="75001"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Ville -->
          <div>
            <label for="city" class="block text-sm font-semibold text-gray-700 mb-2">
              Ville *
            </label>
            <input
              type="text"
              id="city"
              name="city"
              placeholder="Paris"
              value={cityName || ''}
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Surface -->
          <div>
            <label for="surface" class="block text-sm font-semibold text-gray-700 mb-2">
              Surface à chauffer (m²) *
            </label>
            <input
              type="number"
              id="surface"
              name="surface"
              min="20"
              max="300"
              placeholder="100"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Type de logement -->
          <div>
            <label for="housing_type" class="block text-sm font-semibold text-gray-700 mb-2">
              Type de logement *
            </label>
            <select
              id="housing_type"
              name="housing_type"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            >
              <option value="">Sélectionnez</option>
              <option value="maison">Maison individuelle</option>
              <option value="appartement">Appartement</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <!-- Conduit existant -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Avez-vous un conduit de cheminée existant ?
            </label>
            <div class="flex space-x-4">
              <label class="flex items-center">
                <input type="radio" name="existing_chimney" value="oui" class="mr-2 text-primary-600 focus:ring-primary-500" />
                <span>Oui</span>
              </label>
              <label class="flex items-center">
                <input type="radio" name="existing_chimney" value="non" class="mr-2 text-primary-600 focus:ring-primary-500" />
                <span>Non</span>
              </label>
              <label class="flex items-center">
                <input type="radio" name="existing_chimney" value="ne_sais_pas" class="mr-2 text-primary-600 focus:ring-primary-500" checked />
                <span>Je ne sais pas</span>
              </label>
            </div>
          </div>

          <!-- Prénom -->
          <div>
            <label for="first_name" class="block text-sm font-semibold text-gray-700 mb-2">
              Prénom *
            </label>
            <input
              type="text"
              id="first_name"
              name="first_name"
              placeholder="Jean"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Nom -->
          <div>
            <label for="last_name" class="block text-sm font-semibold text-gray-700 mb-2">
              Nom *
            </label>
            <input
              type="text"
              id="last_name"
              name="last_name"
              placeholder="Dupont"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="jean.dupont@example.com"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Téléphone -->
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
              Téléphone *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              pattern="[0-9]{10}"
              placeholder="0123456789"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              required
            />
          </div>

          <!-- Message -->
          <div class="md:col-span-2">
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
              Informations complémentaires (optionnel)
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Précisez vos besoins, vos préférences de marque, votre budget..."
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors resize-none"
            ></textarea>
          </div>

          <!-- RGPD -->
          <div class="md:col-span-2">
            <label class="flex items-start">
              <input
                type="checkbox"
                name="rgpd"
                class="mt-1 mr-3 text-primary-600 focus:ring-primary-500 rounded"
                required
              />
              <span class="text-sm text-gray-600">
                J'accepte que mes données soient utilisées pour me recontacter dans le cadre de ma demande de devis. *
              </span>
            </label>
          </div>
        </div>

        <div class="mt-8">
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-bold py-4 px-8 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02] flex items-center justify-center space-x-2"
          >
            <span>Recevoir mon devis gratuit</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </div>

        <p class="text-xs text-gray-500 text-center mt-4">
          * Champs obligatoires. Vos données sont protégées et ne seront jamais revendues.
        </p>
      </form>

      <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Demande envoyée avec succès !</h3>
        <p class="text-gray-600 mb-4">
          Merci pour votre confiance. Un conseiller vous contactera dans les 24h pour étudier votre projet.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const formSuccess = document.getElementById('form-success');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async () => {
    // Désactiver le bouton pendant la soumission
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.innerHTML = '<span>Envoi en cours...</span>';
    }

    // Track conversion avec Google Analytics
    if (typeof window !== 'undefined' && (window as any).gtag) {
      (window as any).gtag('event', 'conversion', {
        'send_to': 'AW-CONVERSION_ID/CONVERSION_LABEL',
        'value': 1.0,
        'currency': 'EUR'
      });
    }

    // Netlify Forms gère automatiquement la soumission
    // Pas besoin de e.preventDefault() - le formulaire sera soumis normalement
  });
</script>
