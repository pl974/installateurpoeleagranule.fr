---
import { cities } from '../data/cities';
import { siteConfig } from '../data/seo';

// Get top 12 cities for footer
const topCities = cities.slice(0, 12);
---

<footer class="bg-accent-900 text-gray-300">
  <!-- Main Footer -->
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div>
        <div class="flex items-center space-x-2 mb-4">
          <div class="bg-gradient-to-br from-primary-500 to-primary-600 p-2 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
            </svg>
          </div>
          <span class="font-display font-bold text-white text-lg">
            Installateur Poêle à Granulé
          </span>
        </div>
        <p class="text-sm mb-4">
          Expert certifié RGE en installation de poêles à granulés partout en France. Devis gratuit, aides financières, installation professionnelle.
        </p>
        <div class="flex space-x-3">
          <a href="#" class="text-gray-400 hover:text-primary-500 transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-primary-500 transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Liens rapides</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-primary-500 transition-colors">Accueil</a></li>
          <li><a href="/marques" class="hover:text-primary-500 transition-colors">Marques de poêles</a></li>
          <li><a href="/aides-financieres" class="hover:text-primary-500 transition-colors">Aides financières</a></li>
          <li><a href="/guide" class="hover:text-primary-500 transition-colors">Guide complet</a></li>
          <li><a href="/prix-installation" class="hover:text-primary-500 transition-colors">Prix d'installation</a></li>
          <li><a href="/contact" class="hover:text-primary-500 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Popular Cities -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Nos zones d'intervention</h3>
        <ul class="space-y-2 text-sm">
          {topCities.slice(0, 6).map(city => (
            <li>
              <a href={`/ville/${city.slug}`} class="hover:text-primary-500 transition-colors">
                {city.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+33123456789" class="hover:text-primary-500 transition-colors">
              01 23 45 67 89
            </a>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteConfig.contactEmail}`} class="hover:text-primary-500 transition-colors">
              {siteConfig.contactEmail}
            </a>
          </li>
          <li class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Lun-Ven: 8h-19h<br />Sam: 9h-17h</span>
          </li>
        </ul>

        <div class="mt-4 p-3 bg-accent-800 rounded-lg">
          <p class="text-xs text-gray-400 mb-1">Certifications</p>
          <div class="flex items-center space-x-2">
            <span class="text-xs font-semibold text-white bg-primary-600 px-2 py-1 rounded">RGE Qualibois</span>
            <span class="text-xs font-semibold text-white bg-green-600 px-2 py-1 rounded">Flamme Verte</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-accent-800">
    <div class="container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-sm text-gray-400">
          © {new Date().getFullYear()} {siteConfig.name}. Tous droits réservés.
        </p>
        <div class="flex space-x-6 text-sm">
          <a href="/mentions-legales" class="text-gray-400 hover:text-primary-500 transition-colors">
            Mentions légales
          </a>
          <a href="/politique-confidentialite" class="text-gray-400 hover:text-primary-500 transition-colors">
            Politique de confidentialité
          </a>
          <a href="/cgv" class="text-gray-400 hover:text-primary-500 transition-colors">
            CGV
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
